+def _max_trace_rowid(db_path):
+    """Local fix: highest trace rowid right after the seed posts."""
+    import sqlite3
+    try:
+        con = sqlite3.connect(db_path)
+        r = con.execute("SELECT COALESCE(MAX(rowid), 0) FROM trace").fetchone()[0]
+        con.close()
+        return int(r or 0)
+    except Exception:
+        return 0
